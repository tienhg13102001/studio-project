PORT=5002
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
MONGODB_URI=mongodb://admin:secret@localhost:27017/beez?authSource=admin
PUBLIC_URL=http://localhost:5002

# ── Email thông báo khách mới (tuỳ chọn) ──────────────────────────────────────
# Thiếu các biến này thì form liên hệ vẫn lưu lead bình thường, chỉ không gửi mail.
# Gmail: bật 2FA rồi tạo "App password" 16 ký tự, dùng làm SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
# Tên + địa chỉ hiện ở ô "From" của email gửi đi.
MAIL_FROM=BeeZ Production <your-account@gmail.com>
# Nơi nhận thông báo có khách mới (nhiều địa chỉ cách nhau bằng dấu phẩy).
LEAD_NOTIFY_TO=sales@beezvn.com

# Khoá ký token đăng nhập portal. Bắt buộc — thiếu thì backend không khởi động.
# Sinh khoá mới: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai
# Tuỳ chọn, mặc định 7d.
#JWT_EXPIRES_IN=7d
